# ============================================================================
# NEXUS AI - environment template
# Copy to `.env` at the repository root (the backend reads `.env` and `../.env`).
#   cp .env.example .env
# Never commit a real `.env`. API keys are read from this file only - the code
# contains no hardcoded secrets and no key is required to run the demo.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=NEXUS AI
# development | staging | production  (production hides exception detail from responses)
ENVIRONMENT=development
DEBUG=true

# --- Database ----------------------------------------------------------------
# Default: SQLite, so the platform runs with no database server installed.
DATABASE_URL=sqlite:///./data/nexus.db
# PostgreSQL (docker-compose uses this):
# DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexus
# Log every SQL statement (very noisy; diagnostics only).
SQLALCHEMY_ECHO=false

# Seed the four sandbox accounts, the nine agents and the 22-tool catalog on boot.
SEED_DEMO_DATA=true
# Password for the seeded accounts in backend/app/seed.py. Change it for anything
# that is not a local sandbox.
DEMO_PASSWORD=NexusDemo2026!

# --- Redis (optional) --------------------------------------------------------
# Leave unset for a single-machine run: workflow execution uses an in-process
# worker pool. Setting it only advertises the queue in /api/settings.
# REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONCURRENCY=4

# --- Auth / security ---------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at boot and existing tokens stop working.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- LLM provider ------------------------------------------------------------
# auto | gemini | openai | ollama | none
# `auto` selects the first provider whose key/URL below is present, and falls
# back to `none`, in which case the deterministic rule planner is used. The full
# demo works with every key left blank.
LLM_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint, e.g. an internal gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# Empty means "not configured". Start a local model with `ollama pull llama3.1`.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

LLM_TIMEOUT_SECONDS=60

# --- Orchestration -----------------------------------------------------------
# LangGraph checkpoint store. Always a local SQLite file, even when the main
# database is PostgreSQL, so keep the directory writable and backed up together
# with the app data; it is what lets a paused workflow resume after a restart.
CHECKPOINT_DATABASE_PATH=./data/nexus_checkpoints.db
# Where generated offer letters, onboarding packs and invoice summaries are written.
GENERATED_DOCUMENTS_DIR=./data/generated_documents

# Failure recovery: delay = base_delay * factor ** (attempt - 1), capped by
# MAX_TASK_ATTEMPTS. Tools marked retry_safe=false are never auto-retried, so a
# payment is never issued twice.
MAX_TASK_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_BACKOFF_FACTOR=2.0
# Where the escalation notification points when retries are exhausted.
WORKFLOW_ESCALATION_EMAIL=it-administrator@nexus-ai.example

# --- Frontend (optional) -----------------------------------------------------
# Vite only reads env files inside `frontend/`. Copy this block to
# `frontend/.env.local` if you need to override any of them - the defaults below
# are already what `npm run dev` and the nginx container use.
#
# Base URL for API calls. Leave empty to use same-origin requests, which is what
# the Vite dev proxy and the nginx container both rely on.
# VITE_API_BASE_URL=
# Where `npm run dev` proxies /api.
# VITE_API_TARGET=http://127.0.0.1:8000
# VITE_PORT=5173
